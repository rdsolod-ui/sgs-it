{
  "name": "sgs-it-parkops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'tsx watch server/index.ts' 'vite --host 127.0.0.1 --port 5178'",
    "build": "tsc --noEmit && NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/admin.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/browser.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:browser": "tsx tests/browser.ts",
    "retention": "tsx scripts/retention.ts",
    "build:preview": "tsc --noEmit && NODE_ENV=production VITE_PUBLIC_PREVIEW=true VITE_PUBLIC_BASE=/sgs-it/ vite build && node scripts/prepare-preview.mjs",
    "test:preview": "tsx tests/preview.ts",
    "test:intro": "tsx tests/brand-intro.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.3",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.4",
    "gsap": "3.15.0",
    "js-tiktoken": "1.0.21",
    "lucide-react": "1.46.0",
    "openai": "7.15.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zod": "4.6.5"
  }
}
