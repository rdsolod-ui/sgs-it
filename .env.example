NODE_ENV=development
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5178
DATABASE_URL=postgresql://localhost:55438/sgsit
AI_MODE=demo
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# Enable only after account/region and data-transfer review.
OPENAI_APPROVED=false
AI_INPUT_TOKENS=700
AI_CONTEXT_TOKENS=6000
AI_OUTPUT_TOKENS=1200
AI_VISIBLE_TOKENS=450
AI_DAILY_USD=1
AI_TOTAL_USD=10
# Defaults for Luna only. A model change requires a reviewed price profile.
AI_INPUT_USD_PER_M=0.25
AI_OUTPUT_USD_PER_M=1.20
AI_PRICE_MODEL=gpt-5.6-luna
LEGAL_READY=false
OPERATOR_REQUISITES=
PRIVACY_EMAIL=
TELEGRAM_BOT_TOKEN=
CHAT_RETENTION_DAYS=30
LEAD_RETENTION_DAYS=180

# No source tracking or external notifications unless reviewed and explicitly enabled.
ATTRIBUTION_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFICATIONS_APPROVED=false
# Separate notification bot; do not reuse the Mini App token implicitly.
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_NOTIFICATION_BOT_ID=
TELEGRAM_NOTIFICATION_CHAT_ID=
# Reviewed document version and exact disclosure supplied by the operator.
LEGAL_POLICY_VERSION=
TELEGRAM_NOTIFICATION_NOTICE=
